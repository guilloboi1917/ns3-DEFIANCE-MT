@@ -237,6 +238,8 @@ class NR_EXPORT NrChannelHelper : public Object
         {ChannelModel::ThreeGpp, Scenario::UMi},
         // 3GPP-UMa
         {ChannelModel::ThreeGpp, Scenario::UMa},
+        // 3GPP-UMa-AV
